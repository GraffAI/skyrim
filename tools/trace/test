#!/usr/bin/env python3
"""tools/trace/check over its fixtures (006 M44 I187; a gate of this zone, since traces stay off
git, D358). The fixtures are synthetic and hand-written: no recorded data. `good.jsonl` must pass,
naming its one out-of-dictionary `out.evt` and its one case-only match; each `bad-*.jsonl` must
fail with its rule.

    python3 -I tools/trace/test
"""
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
FIX = os.path.join(HERE, "fixtures")
CASES = [  # file, exit code, text that must appear in the output
    ("good.jsonl", 0, ": ok run=1 graph=1 frame=3 dt=3 in.var=1 in.evt=1 out.evt=2 out.var=1"),
    ("good.jsonl", 0, "warn: graph.evts is not in ORACLE.md 3.2"),
    ("good.jsonl", 0, "out.evt outside the graph's evts: 1 record(s), 1 name(s): subGraphTag=1"),
    ("good.jsonl", 0, "in.evt WalkStart (walkStart)=1"),
    ("bad-key.jsonl", 1, ":9: key: out.evt has 'ptr'"),
    ("bad-address.jsonl", 1, ":9: address: .p = 'at 0x7FF6A0B1C2D3'"),
    ("bad-variable.jsonl", 1, ":7: name: in.var 'NotDeclared' is not in the graph's vars"),
    ("bad-event.jsonl", 1, ":8: name: in.evt 'neverDeclared' is not in the graph's evts"),
    ("bad-decimal.jsonl", 1, ":3: decimal: .cell = '140712345678'"),
    ("bad-frames.jsonl", 1, ":12: frame: f 0 after f 1"),
    ("bad-first.jsonl", 1, ":1: first: the first record is 'graph', not 'run'"),
]


def main():
    fail = 0
    for name, want_rc, want in CASES:
        p = subprocess.run([sys.executable, "-I", os.path.join(HERE, "check"), os.path.join(FIX, name)],
                           capture_output=True, text=True)
        ok = p.returncode == want_rc and want in p.stdout
        print(f"{'ok  ' if ok else 'FAIL'} {name}: exit {p.returncode} (want {want_rc}), {want!r}")
        if not ok:
            fail = 1
            sys.stdout.write(p.stdout + p.stderr)
    missing = sorted(set(f for f in os.listdir(FIX) if f.endswith(".jsonl")) - {c[0] for c in CASES})
    if missing:
        fail = 1
        print(f"FAIL fixtures with no case: {' '.join(missing)}")
    return fail


if __name__ == "__main__":
    sys.exit(main())
